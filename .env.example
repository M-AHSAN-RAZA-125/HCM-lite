# Required by the API server. Use a private MongoDB database and a random secret.
MONGODB_URI=mongodb://127.0.0.1:27017/hcm_lite
SESSION_SECRET=replace-with-a-long-random-secret
APP_ORIGIN=http://localhost:3000
PORT=3001
NODE_ENV=development

# Optional provider adapter. Leave blank to keep face enrollment/login disabled.
# The server expects POST /enroll and POST /verify; see README for the contract.
FACE_VERIFICATION_PROVIDER_URL=
FACE_VERIFICATION_API_KEY=

# Optional one-time initial Admin bootstrap. Must be kept secret and rotated/removed.
INITIAL_ADMIN_SETUP_TOKEN=

# Existing AI Studio integration (server-side only where applicable).
GEMINI_API_KEY=

# Non-secret frontend hint only; backend provider configuration remains authoritative.
VITE_FACE_VERIFICATION_PROVIDER=
